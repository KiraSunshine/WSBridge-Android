<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- VPN-приложение: systemExempted — единственный FGS-тип для VpnService на API 34+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- NetworkMonitor: registerDefaultNetworkCallback и getNetworkCapabilities без
         этого разрешения бросают SecurityException. Разрешение нормальное (не
         dangerous) — запрос у пользователя не нужен. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Нуджи «сеть сменилась» и «туннель включён давно». На API 33+ без него
         NotificationManager молча ничего не показывает; сам запрос разрешения
         делает UI (вне этого файла). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".WSBridgeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.WSBridge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".tunnel.TunnelService"
            android:exported="true"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>

</manifest>
